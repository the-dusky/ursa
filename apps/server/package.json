    "board-game",
    "multiplayer"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@y/websocket-server": "^0.1.1",
    "y-websocket": "^3.0.0"
  }
}