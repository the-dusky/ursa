{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "description": "Y.js WebSocket server for Seasonal Board Game multiplayer",
  "main": "y-websocket-server.js",
  "scripts": {
    "start": "DEBUG=y-websocket npx y-websocket",
    "dev": "DEBUG=y-websocket npx y-websocket",
    "docker:build": "docker build -t y-websocket-server .",
    "docker:run": "docker run -p 1234:1234 y-websocket-server",
    "docker:dev": "docker run -p 1234:1234 --rm y-websocket-server",
    "test": "echo \"No tests yet\""
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
